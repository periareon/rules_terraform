load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")
load("//tofu:tofu_binary.bzl", "tofu_binary")
load("//tofu:tofu_fmt_test.bzl", "tofu_fmt_test")
load("//tofu:tofu_validate_test.bzl", "tofu_validate_test")

terraform_module(
    name = "with_registry_module",
    srcs = glob(["*.tf"]),
    # Resolved through `tofu.deps`, i.e. against registry.opentofu.org; the
    # other registry fixtures go through `terraform.deps`.
    deps = [
        "@test_tofu_registry_modules",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_registry_module",
)

terraform_validate_test(
    name = "with_registry_module_test",
    target = ":with_registry_module",
)

terraform_fmt_test(
    name = "with_registry_module_fmt_test",
    target = ":with_registry_module",
)

tofu_binary(
    name = "tofu",
    root = ":with_registry_module",
)

tofu_validate_test(
    name = "with_registry_module_tofu_test",
    target = ":with_registry_module",
)

tofu_fmt_test(
    name = "with_registry_module_tofu_fmt_test",
    target = ":with_registry_module",
)
