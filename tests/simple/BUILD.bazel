load("//terraform:defs.bzl", "terraform_binary", "terraform_fmt_test", "terraform_module", "terraform_validate_test")

# Loaded through the two public `defs.bzl` files on purpose. Every other
# fixture loads the per-rule files, so this is the one place a symbol missing
# from `defs.bzl` — the entry point most downstream users take — would fail
# `bazel test //...` instead of a user's first build.
load("//tofu:defs.bzl", "tofu_binary", "tofu_fmt_test", "tofu_validate_test")

terraform_module(
    name = "simple",
    srcs = glob(["*.tf"]),
)

terraform_binary(
    name = "terraform",
    root = ":simple",
)

terraform_validate_test(
    name = "simple_test",
    target = ":simple",
)

terraform_fmt_test(
    name = "simple_fmt_test",
    target = ":simple",
)

tofu_binary(
    name = "tofu",
    root = ":simple",
)

tofu_validate_test(
    name = "simple_tofu_test",
    target = ":simple",
)

tofu_fmt_test(
    name = "simple_tofu_fmt_test",
    target = ":simple",
)
