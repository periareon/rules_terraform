load("//opentofu:opentofu_fmt_test.bzl", "opentofu_fmt_test")
load("//opentofu:opentofu_validate_test.bzl", "opentofu_validate_test")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")

# `deps` names only the module this one references directly. `compute` pulls
# `network` in through its own `deps`, and the init aspect follows the closure.
terraform_module(
    name = "app",
    srcs = glob(["*.tf"]),
    deps = ["//tests/parentrel/modules/compute"],
)

terraform_validate_test(
    name = "app_test",
    target = ":app",
)

terraform_fmt_test(
    name = "app_fmt_test",
    target = ":app",
)

opentofu_validate_test(
    name = "app_tofu_test",
    target = ":app",
)

opentofu_fmt_test(
    name = "app_tofu_fmt_test",
    target = ":app",
)
