load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")
load("//tofu:tofu_binary.bzl", "tofu_binary")
load("//tofu:tofu_fmt_test.bzl", "tofu_fmt_test")
load("//tofu:tofu_validate_test.bzl", "tofu_validate_test")

terraform_module(
    name = "with_modules",
    srcs = glob(["*.tf"]),
    deps = [
        "//tests/with_modules/modules/network",
        "//tests/with_modules/modules/storage",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_modules",
)

terraform_validate_test(
    name = "with_modules_test",
    target = ":with_modules",
)

terraform_fmt_test(
    name = "with_modules_fmt_test",
    target = ":with_modules",
)

tofu_binary(
    name = "tofu",
    root = ":with_modules",
)

tofu_validate_test(
    name = "with_modules_tofu_test",
    target = ":with_modules",
)

tofu_fmt_test(
    name = "with_modules_tofu_fmt_test",
    target = ":with_modules",
)
