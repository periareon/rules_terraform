load("//opentofu:opentofu_binary.bzl", "opentofu_binary")
load("//opentofu:opentofu_fmt_test.bzl", "opentofu_fmt_test")
load("//opentofu:opentofu_providers_lock.bzl", "opentofu_providers_lock")
load("//opentofu:opentofu_validate_test.bzl", "opentofu_validate_test")
load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load(
    "//terraform:terraform_modules_lock.bzl",
    "terraform_lock_diff_test",
    "terraform_providers_lock",
    "terraform_providers_lock_test",
)
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")

exports_files([".terraform.lock.hcl"])

terraform_module(
    name = "with_third_party_provider",
    srcs = glob(["*.tf"]),
    lock = ".terraform.lock.hcl",
    deps = [
        "@test_providers_with_third_party//carlpett_sops",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_third_party_provider",
)

terraform_validate_test(
    name = "with_third_party_provider_test",
    target = ":with_third_party_provider",
)

terraform_fmt_test(
    name = "with_third_party_provider_fmt_test",
    target = ":with_third_party_provider",
)

terraform_providers_lock_test(
    name = "with_third_party_provider_providers_lock_test",
    lock = ".terraform.lock.hcl",
    target = ":with_third_party_provider",
)

opentofu_binary(
    name = "tofu",
    root = ":with_third_party_provider",
)

opentofu_validate_test(
    name = "with_third_party_provider_tofu_test",
    target = ":with_third_party_provider",
)

opentofu_fmt_test(
    name = "with_third_party_provider_tofu_fmt_test",
    target = ":with_third_party_provider",
)

terraform_lock_diff_test(
    name = "with_third_party_provider_terraform_lock_diff_test",
    golden = "testdata/terraform.golden.terraform.lock.hcl",
    regenerate_hint = "bazel run //tests/with_third_party_provider:terraform_golden.regen",
    target = ":with_third_party_provider",
)

terraform_lock_diff_test(
    name = "with_third_party_provider_opentofu_lock_diff_test",
    golden = "testdata/opentofu.golden.terraform.lock.hcl",
    regenerate_hint = "bazel run //tests/with_third_party_provider:opentofu_golden.regen",
    target = ":with_third_party_provider",
)

terraform_providers_lock(
    name = "terraform_golden.regen",
    output = "testdata/terraform.golden.terraform.lock.hcl",
    target = ":with_third_party_provider",
)

opentofu_providers_lock(
    name = "opentofu_golden.regen",
    output = "testdata/opentofu.golden.terraform.lock.hcl",
    target = ":with_third_party_provider",
)
