load("//opentofu:opentofu_binary.bzl", "opentofu_binary")
load("//opentofu:opentofu_fmt_test.bzl", "opentofu_fmt_test")
load("//opentofu:opentofu_validate_test.bzl", "opentofu_validate_test")
load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")

# Diff-test coverage skipped for this fixture: it uses a `module_sources`-
# mapped Bazel module (`./mymod` → `//tests/modules_lib/mymod`), which real
# `terraform init` can't resolve in a bare temp dir. The provider-lock logic
# under test is already covered by `//tests/with_provider`,
# `//tests/with_third_party_provider`, and `//tests/with_tf_tests`.

terraform_module(
    name = "with_mixed_deps",
    srcs = glob(["*.tf"]),
    lock = ".terraform.lock.hcl",
    module_sources = {
        "./mymod": "//tests/modules_lib/mymod",
    },
    deps = [
        "//tests/modules_lib/mymod",
        "@test_providers_with_provider//hashicorp_null",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_mixed_deps",
)

terraform_validate_test(
    name = "with_mixed_deps_test",
    target = ":with_mixed_deps",
)

terraform_fmt_test(
    name = "with_mixed_deps_fmt_test",
    target = ":with_mixed_deps",
)

opentofu_binary(
    name = "tofu",
    root = ":with_mixed_deps",
)

opentofu_validate_test(
    name = "with_mixed_deps_tofu_test",
    target = ":with_mixed_deps",
)

opentofu_fmt_test(
    name = "with_mixed_deps_tofu_fmt_test",
    target = ":with_mixed_deps",
)
