load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")

terraform_module(
    name = "with_constraint_module",
    srcs = glob(["*.tf"]),
    deps = ["@test_constraint_modules"],
)

terraform_binary(
    name = "terraform",
    root = ":with_constraint_module",
)

terraform_validate_test(
    name = "with_constraint_module_test",
    target = ":with_constraint_module",
)

terraform_fmt_test(
    name = "with_constraint_module_fmt_test",
    target = ":with_constraint_module",
)
