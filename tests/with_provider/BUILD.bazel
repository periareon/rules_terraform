load("//opentofu:opentofu_binary.bzl", "opentofu_binary")
load("//opentofu:opentofu_fmt_test.bzl", "opentofu_fmt_test")
load("//opentofu:opentofu_providers_lock.bzl", "opentofu_providers_lock")
load("//opentofu:opentofu_validate_test.bzl", "opentofu_validate_test")
load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_modules_lock.bzl", "terraform_lock_diff_test", "terraform_providers_lock")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")

terraform_module(
    name = "with_provider",
    srcs = glob(["*.tf"]),
    lock = ".terraform.lock.hcl",
    deps = [
        "@test_providers_with_provider//hashicorp_null",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_provider",
)

terraform_validate_test(
    name = "with_provider_test",
    target = ":with_provider",
)

terraform_fmt_test(
    name = "with_provider_fmt_test",
    target = ":with_provider",
)

opentofu_binary(
    name = "tofu",
    root = ":with_provider",
)

opentofu_validate_test(
    name = "with_provider_tofu_test",
    target = ":with_provider",
)

opentofu_fmt_test(
    name = "with_provider_tofu_fmt_test",
    target = ":with_provider",
)

# Structural diff of the init-aspect-generated .terraform.lock.hcl against
# a golden produced by real `terraform providers lock`. Catches drift between
# the aspect's output and what upstream Terraform would generate.
terraform_lock_diff_test(
    name = "with_provider_terraform_lock_diff_test",
    golden = "testdata/terraform.golden.terraform.lock.hcl",
    regenerate_hint = "bazel run //tests/with_provider:terraform_golden.regen",
    target = ":with_provider",
)

# Same diff against a golden from real `tofu providers lock`, verifying
# that our aspect output is equally acceptable to OpenTofu.
terraform_lock_diff_test(
    name = "with_provider_opentofu_lock_diff_test",
    golden = "testdata/opentofu.golden.terraform.lock.hcl",
    regenerate_hint = "bazel run //tests/with_provider:opentofu_golden.regen",
    target = ":with_provider",
)

# `bazel run //tests/with_provider:terraform_golden.regen` regenerates the
# Terraform-side golden by running real `terraform providers lock` under the
# toolchain-fetched terraform binary.
terraform_providers_lock(
    name = "terraform_golden.regen",
    output = "testdata/terraform.golden.terraform.lock.hcl",
    target = ":with_provider",
)

opentofu_providers_lock(
    name = "opentofu_golden.regen",
    output = "testdata/opentofu.golden.terraform.lock.hcl",
    target = ":with_provider",
)
