load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_plan_test.bzl", "terraform_plan_test")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")
load("//tofu:tofu_binary.bzl", "tofu_binary")
load("//tofu:tofu_fmt_test.bzl", "tofu_fmt_test")
load("//tofu:tofu_plan_test.bzl", "tofu_plan_test")
load("//tofu:tofu_validate_test.bzl", "tofu_validate_test")

terraform_module(
    name = "with_provider",
    srcs = glob(["*.tf"]),
    lock = ".terraform.lock.hcl",
    deps = [
        "@test_providers_with_provider//hashicorp_null",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_provider",
)

terraform_validate_test(
    name = "with_provider_test",
    target = ":with_provider",
)

# The `null` provider plans without credentials or network, so these exercise
# the plan test end to end: backend init, `-detailed-exitcode`, and the plan
# artefacts under test.outputs/. The fixture creates one resource, so the plan
# is never empty and `expect_no_changes` would fail here by design.
terraform_plan_test(
    name = "with_provider_plan_test",
    root = ":with_provider",
)

tofu_plan_test(
    name = "with_provider_tofu_plan_test",
    root = ":with_provider",
)

terraform_fmt_test(
    name = "with_provider_fmt_test",
    target = ":with_provider",
)

tofu_binary(
    name = "tofu",
    root = ":with_provider",
)

tofu_validate_test(
    name = "with_provider_tofu_test",
    target = ":with_provider",
)

tofu_fmt_test(
    name = "with_provider_tofu_fmt_test",
    target = ":with_provider",
)
