load("@rules_terraform//terraform:defs.bzl", "terraform_binary", "terraform_module", "terraform_providers_lock", "terraform_providers_lock_test")

terraform_module(
    name = "prod",
    srcs = ["main.tf"],
    data = [
        "NOTES.md",
        "templates/user-data.tpl",
    ],
    deps = [
        "//modules/net",
        "@tf_envs_prod",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":prod",
)

terraform_providers_lock_test(
    name = "providers_lock",
    lock = ".terraform.lock.hcl",
    target = ":prod",
)

terraform_providers_lock(
    name = "providers_lock.update",
    output = ".terraform.lock.hcl",
    target = ":prod",
)
