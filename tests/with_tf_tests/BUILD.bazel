load("//opentofu:opentofu_binary.bzl", "opentofu_binary")
load("//opentofu:opentofu_fmt_test.bzl", "opentofu_fmt_test")
load("//opentofu:opentofu_test.bzl", "opentofu_test")
load("//opentofu:opentofu_validate_test.bzl", "opentofu_validate_test")
load("//terraform:terraform_binary.bzl", "terraform_binary")
load("//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("//terraform:terraform_module.bzl", "terraform_module")
load("//terraform:terraform_test.bzl", "terraform_test")
load("//terraform:terraform_validate_test.bzl", "terraform_validate_test")

# Diff-test coverage skipped: the `.tftest.hcl` file causes each engine to
# discover extra implicit provider references (OpenTofu adds an empty
# `registry.opentofu.org/hashicorp/null` block for the test framework's
# implicit resolution), which makes a clean diff finicky. Simpler-provider
# fixtures cover the lock-generation logic under test.

terraform_module(
    name = "with_tf_tests",
    srcs = glob(["*.tf"]),
    data = glob(["*.tftest.hcl"]),
    lock = ".terraform.lock.hcl",
    deps = [
        "@test_providers_with_provider//hashicorp_null",
    ],
)

terraform_binary(
    name = "terraform",
    root = ":with_tf_tests",
)

terraform_validate_test(
    name = "with_tf_tests_validate",
    target = ":with_tf_tests",
)

terraform_fmt_test(
    name = "with_tf_tests_fmt",
    target = ":with_tf_tests",
)

terraform_test(
    name = "with_tf_tests_tftest",
    root = ":with_tf_tests",
)

opentofu_binary(
    name = "tofu",
    root = ":with_tf_tests",
)

opentofu_validate_test(
    name = "with_tf_tests_tofu_validate",
    target = ":with_tf_tests",
)

opentofu_fmt_test(
    name = "with_tf_tests_tofu_fmt",
    target = ":with_tf_tests",
)

opentofu_test(
    name = "with_tf_tests_tofu_tftest",
    root = ":with_tf_tests",
)
