load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_rust_mdbook//:defs.bzl", "mdbook", "mdbook_server")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

# Rule/aspect .bzl files. Extensions are skipped here (their transitive
# load of @bazel_tools//tools/build_defs/repo:http.bzl breaks stardoc's
# bzl_library discovery); those pages are hand-written under `src/`.
_TERRAFORM_RULE_DOCS = [
    "terraform_binary",
    "terraform_external_module",
    "terraform_fmt_aspect",
    "terraform_fmt_test",
    "terraform_module",
    "terraform_plan_test",
    "terraform_provider",
    "terraform_providers_lock",
    "terraform_providers_lock_test",
    "terraform_test",
    "terraform_validate_aspect",
    "terraform_validate_test",
]

_TOFU_RULE_DOCS = [
    "tofu_binary",
    "tofu_external_module",
    "tofu_fmt_test",
    "tofu_module",
    "tofu_plan_test",
    "tofu_provider",
    "tofu_providers_lock",
    "tofu_providers_lock_test",
    "tofu_test",
    "tofu_validate_test",
]

[
    stardoc(
        name = "terraform_{}".format(name),
        out = "src/terraform/{}.md".format(name),
        input = "//terraform:{}.bzl".format(name),
        table_of_contents_template = "@stardoc//stardoc:templates/markdown_tables/table_of_contents.vm",
        tags = ["manual"],
        deps = ["@rules_terraform//terraform:defs_bzl"],
    )
    for name in _TERRAFORM_RULE_DOCS
]

[
    stardoc(
        name = "tofu_{}".format(name),
        out = "src/tofu/{}.md".format(name),
        input = "//tofu:{}.bzl".format(name),
        table_of_contents_template = "@stardoc//stardoc:templates/markdown_tables/table_of_contents.vm",
        tags = ["manual"],
        deps = ["@rules_terraform//tofu:defs_bzl"],
    )
    for name in _TOFU_RULE_DOCS
]

# Settings pages: render each engine's `settings.bzl` using a custom
# per-function template that treats each function as documentation for
# the same-named build setting.
bzl_library(
    name = "terraform_settings_bzl",
    srcs = ["//terraform/settings:settings.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "tofu_settings_bzl",
    srcs = ["//tofu/settings:settings.bzl"],
    deps = ["//tofu/private:bzl_lib"],
)

stardoc(
    name = "terraform_settings",
    out = "src/terraform/settings.md",
    func_template = "templates/settings_func.vm",
    input = "//terraform/settings:settings.bzl",
    tags = ["manual"],
    deps = [":terraform_settings_bzl"],
)

stardoc(
    name = "tofu_settings",
    out = "src/tofu/settings.md",
    func_template = "templates/settings_func.vm",
    input = "//tofu/settings:settings.bzl",
    tags = ["manual"],
    deps = [":tofu_settings_bzl"],
)

mdbook(
    name = "book",
    srcs = glob(["src/**/*.md"]) + [
        ":terraform_{}".format(name)
        for name in _TERRAFORM_RULE_DOCS
    ] + [
        ":tofu_{}".format(name)
        for name in _TOFU_RULE_DOCS
    ] + [
        ":terraform_settings",
        ":tofu_settings",
    ],
    book = "book.toml",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

alias(
    name = "docs",
    actual = ":book",
    tags = ["manual"],
)

mdbook_server(
    name = "server",
    book = ":book",
    tags = ["manual"],
)

sh_binary(
    name = "publish_book",
    srcs = ["publish_book.sh"],
    data = [":book"],
    env = {"BOOK_DIR": "$(rootpath :book)"},
    tags = ["manual"],
)
