load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_rust_mdbook//:defs.bzl", "mdbook", "mdbook_server")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

# Rule/aspect .bzl files. Extensions are skipped here (their transitive
# load of @bazel_tools//tools/build_defs/repo:http.bzl breaks stardoc's
# bzl_library discovery); those pages are hand-written under `src/`.
_TERRAFORM_RULE_DOCS = [
    "terraform_binary",
    "terraform_fmt_aspect",
    "terraform_fmt_test",
    "terraform_module",
    "terraform_modules_lock",
    "terraform_provider",
    "terraform_provider_group",
    "terraform_test",
    "terraform_validate_aspect",
    "terraform_validate_test",
]

_OPENTOFU_RULE_DOCS = [
    "opentofu_binary",
    "opentofu_fmt_test",
    "opentofu_module",
    "opentofu_provider",
    "opentofu_provider_group",
    "opentofu_test",
    "opentofu_validate_test",
]

[
    stardoc(
        name = "terraform_{}".format(name),
        out = "src/terraform/{}.md".format(name),
        input = "//terraform:{}.bzl".format(name),
        table_of_contents_template = "@stardoc//stardoc:templates/markdown_tables/table_of_contents.vm",
        tags = ["manual"],
        deps = ["@rules_terraform//terraform:defs_bzl"],
    )
    for name in _TERRAFORM_RULE_DOCS
]

[
    stardoc(
        name = "opentofu_{}".format(name),
        out = "src/opentofu/{}.md".format(name),
        input = "//opentofu:{}.bzl".format(name),
        table_of_contents_template = "@stardoc//stardoc:templates/markdown_tables/table_of_contents.vm",
        tags = ["manual"],
        deps = ["@rules_terraform//opentofu:defs_bzl"],
    )
    for name in _OPENTOFU_RULE_DOCS
]

# Settings pages: render each engine's `settings.bzl` using a custom
# per-function template that treats each function as documentation for
# the same-named build setting.
bzl_library(
    name = "terraform_settings_bzl",
    srcs = ["//terraform/settings:settings.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "opentofu_settings_bzl",
    srcs = ["//opentofu/settings:settings.bzl"],
    deps = ["//opentofu/private:bzl_lib"],
)

stardoc(
    name = "terraform_settings",
    out = "src/terraform/settings.md",
    func_template = "templates/settings_func.vm",
    input = "//terraform/settings:settings.bzl",
    tags = ["manual"],
    deps = [":terraform_settings_bzl"],
)

stardoc(
    name = "opentofu_settings",
    out = "src/opentofu/settings.md",
    func_template = "templates/settings_func.vm",
    input = "//opentofu/settings:settings.bzl",
    tags = ["manual"],
    deps = [":opentofu_settings_bzl"],
)

mdbook(
    name = "book",
    srcs = glob(["src/**/*.md"]) + [
        ":terraform_{}".format(name)
        for name in _TERRAFORM_RULE_DOCS
    ] + [
        ":opentofu_{}".format(name)
        for name in _OPENTOFU_RULE_DOCS
    ] + [
        ":opentofu_settings",
        ":terraform_settings",
    ],
    book = "book.toml",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

alias(
    name = "docs",
    actual = ":book",
    tags = ["manual"],
)

mdbook_server(
    name = "server",
    book = ":book",
    tags = ["manual"],
)

sh_binary(
    name = "publish_book",
    srcs = ["publish_book.sh"],
    data = [":book"],
    env = {"BOOK_DIR": "$(rootpath :book)"},
    tags = ["manual"],
)
