    deps = ["//opentofu/private:bzl_lib"],
)

bzl_library(
    name = "opentofu_test_bzl",
    srcs = ["opentofu_test.bzl"],
    deps = ["//opentofu/private:bzl_lib"],
)

bzl_library(
