"""rules_terraform Terraform example.

Textbook Terraform module wrapped in Bazel. rules_terraform is resolved
via `local_path_override`; a real consumer would drop the override and
pin a version from the Bazel Central Registry:

    bazel_dep(name = "rules_terraform", version = "x.y.z")
"""

module(
    name = "rules_terraform_example_terraform",
    version = "0.0.0",
)

bazel_dep(name = "rules_terraform", version = "0.0.0")
local_path_override(
    module_name = "rules_terraform",
    path = "../..",
)

# Toolchains for both terraform and tofu are auto-registered by
# rules_terraform's own MODULE.bazel. Without a `toolchain` tag the build
# uses the newest release rules_terraform ships. This pins one instead, the
# way a project would; a release outside the shipped table costs one fetch
# of its SHA256SUMS, recorded as a fact in MODULE.bazel.lock.
#
# The `terraform` extension fetches every provider named in the checked-in
# `.terraform.lock.hcl`. Providers land in an external repo — you reference
# them from `terraform_module.deps` as `@example_providers//<namespace>_<name>`.
terraform = use_extension("@rules_terraform//terraform:extensions.bzl", "terraform")
terraform.toolchain(version = "1.16.6")
terraform.deps(
    name = "app",
    lock = "//:.terraform.lock.hcl",
)
use_repo(terraform, "app")
