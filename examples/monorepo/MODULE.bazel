"""rules_terraform monorepo example.

A shared module library plus per-environment root modules — the layout most
Terraform monorepos converge on. rules_terraform is resolved via
`local_path_override`; a real consumer would drop the override and pin a
version from the Bazel Central Registry:

    bazel_dep(name = "rules_terraform", version = "x.y.z")
"""

module(
    name = "rules_terraform_example_monorepo",
    version = "0.0.0",
)

bazel_dep(name = "rules_terraform", version = "0.0.0")
local_path_override(
    module_name = "rules_terraform",
    path = "../..",
)

# One `deps` tag per lock file. Each names the providers its lock pins and the
# directories whose `module` blocks reach the registry; the hub carries both.
#
# `shared` is the lock dev and prod use, plus the registry module the `naming`
# library wraps. `staging` is staging's own lock (it uses a provider the
# others do not) plus the registry module staging names itself.
# Archives are pooled across hubs by identity: the `null` provider both locks
# pin, and the `label` module both tags name, are each fetched once.
terraform = use_extension("@rules_terraform//terraform:extensions.bzl", "terraform")
terraform.deps(
    name = "shared",
    lock = "//:.terraform.lock.hcl",
    roots = ["//modules/naming:main.tf"],
)
terraform.deps(
    name = "staging",
    lock = "//envs/staging/app:.terraform.lock.hcl",
    roots = ["//envs/staging/app:main.tf"],
)
use_repo(terraform, "shared", "staging")
