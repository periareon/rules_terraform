"""Prod environment root module.

`deps` names only what this module's own `module` blocks reference. `compute`
pulls `network` in through its own `deps`, and the init aspect follows the whole
closure — so a shared library module can gain a dependency without every
environment that uses it editing a BUILD file.
"""

load("@rules_terraform//terraform:terraform_binary.bzl", "terraform_binary")
load("@rules_terraform//terraform:terraform_fmt_test.bzl", "terraform_fmt_test")
load("@rules_terraform//terraform:terraform_module.bzl", "terraform_module")
load("@rules_terraform//terraform:terraform_providers_lock.bzl", "terraform_providers_lock")
load("@rules_terraform//terraform:terraform_providers_lock_test.bzl", "terraform_providers_lock_test")
load("@rules_terraform//terraform:terraform_test.bzl", "terraform_test")
load("@rules_terraform//terraform:terraform_validate_test.bzl", "terraform_validate_test")

terraform_module(
    name = "app",
    srcs = glob(["*.tf"]),
    # Example environments have no backend; see examples/terraform.
    allow_ephemeral_state = True,
    data = glob(["*.tftest.hcl"]),
    # `@shared` is the hub for the shared lock: every provider it pins, plus the
    # lock itself. A Terraform maintainer who adds a provider edits .tf files
    # and reruns the lock updater; no BUILD file changes.
    deps = [
        "//modules/compute",
        "//modules/naming",
        "//modules/storage",
        "@shared",
    ],
)

# `bazel run //envs/prod/app:terraform -- plan`
terraform_binary(
    name = "terraform",
    root = ":app",
)

# Runs every `run` block in `*.tftest.hcl` via `terraform test`.
terraform_test(
    name = "tftest",
    root = ":app",
)

terraform_validate_test(
    name = "validate",
    target = ":app",
)

terraform_fmt_test(
    name = "fmt",
    target = ":app",
)

# Covers `required_providers` in the shared library too, not just this file.
terraform_providers_lock_test(
    name = "providers_lock",
    lock = "//:.terraform.lock.hcl",
    target = ":app",
)

# `bazel run //envs/prod/app:providers_lock.update` rewrites the repo's shared
# lock for every platform in the default set, using the toolchain-fetched
# engine — nothing has to be installed on the host. It lives here rather than
# at the root because the updater reads this module's sources, and the module
# is visible only to its own package. `output` is relative to this BUILD file,
# so it climbs to the root where the shared lock lives.
#
# Any root module that reaches every provider the repo uses will do; the lock
# is resolved from the transitive `required_providers` blocks of `target`,
# shared library included.
terraform_providers_lock(
    name = "providers_lock.update",
    output = "../../../.terraform.lock.hcl",
    target = ":app",
)
