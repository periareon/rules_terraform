"""Shared library module that itself depends on another shared library module.

`network` is reached with `source = "../network"` — a parent-relative source, so
it only resolves because the init aspect roots the built module tree at the
ancestor `modules/compute` and `modules/network` share.

Because the aspect-based checks in `.bazelrc` validate *every* module, not just
root modules, a library module that names a provider needs the lock and the
provider dep too. That is the wrapper earning its keep: a broken shared module
fails on its own target instead of in whichever environment adopts it next.
"""

load("@rules_terraform//terraform:terraform_module.bzl", "terraform_module")

terraform_module(
    name = "compute",
    srcs = glob(["*.tf"]),
    lock = "//:.terraform.lock.hcl",
    visibility = ["//visibility:public"],
    deps = [
        "//modules/network",
        "@example_providers//hashicorp_null",
    ],
)
