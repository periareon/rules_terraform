)

bzl_library(
    name = "terraform_module_bzl",
    srcs = ["terraform_module.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_providers_lock_bzl",
    srcs = ["terraform_providers_lock.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_providers_lock_test_bzl",
    srcs = ["terraform_providers_lock_test.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
