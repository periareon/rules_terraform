load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//terraform/private:format.bzl", "terraform_formatter")
load("//terraform/private:toolchain.bzl", "current_terraform_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "terraform_binary.bzl",
    "terraform_external_module.bzl",
    "terraform_fmt_aspect.bzl",
    "terraform_fmt_test.bzl",
    "terraform_module.bzl",
    "terraform_plan_test.bzl",
    "terraform_provider.bzl",
    "terraform_providers_lock.bzl",
    "terraform_providers_lock_test.bzl",
    "terraform_test.bzl",
    "terraform_validate_aspect.bzl",
    "terraform_validate_test.bzl",
])

toolchain_type(
    name = "toolchain_type",
)

current_terraform_toolchain(
    name = "current_terraform_toolchain",
)

# `bazel run //terraform:format` rewrites every module's .tf files with
# `terraform fmt`, using the toolchain binary.
terraform_formatter(
    name = "format",
)

bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    deps = [
        ":extensions_bzl",
        ":terraform_binary_bzl",
        ":terraform_external_module_bzl",
        ":terraform_fmt_aspect_bzl",
        ":terraform_fmt_test_bzl",
        ":terraform_module_bzl",
        ":terraform_plan_test_bzl",
        ":terraform_provider_bzl",
        ":terraform_providers_lock_bzl",
        ":terraform_providers_lock_test_bzl",
        ":terraform_test_bzl",
        ":terraform_validate_aspect_bzl",
        ":terraform_validate_test_bzl",
    ],
)

bzl_library(
    name = "extensions_bzl",
    srcs = ["extensions.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_binary_bzl",
    srcs = ["terraform_binary.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_external_module_bzl",
    srcs = ["terraform_external_module.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_fmt_aspect_bzl",
    srcs = ["terraform_fmt_aspect.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_fmt_test_bzl",
