    srcs = ["terraform_provider.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_test_bzl",
    srcs = ["terraform_test.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
    name = "terraform_validate_aspect_bzl",
    srcs = ["terraform_validate_aspect.bzl"],
    deps = ["//terraform/private:bzl_lib"],
)

bzl_library(
