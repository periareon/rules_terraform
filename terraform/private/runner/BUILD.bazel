load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "runner_lib",
    srcs = ["runner.go"],
    importpath = "rules_terraform/terraform/private/runner",
    visibility = ["//visibility:private"],
    deps = [
        "//terraform/private/internal/moduledir",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "runner",
    embed = [":runner_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "runner_test",
    srcs = ["runner_test.go"],
    embed = [":runner_lib"],
    deps = ["@rules_go//go/runfiles"],
)
